# Server Runtime Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omni_socket

# Dual-Tier Rate Limiting Configuration
RATE_LIMIT_SOCKET_WINDOW_MS=10000
RATE_LIMIT_SOCKET_MAX=30
RATE_LIMIT_APP_WINDOW_MS=10000
RATE_LIMIT_APP_MAX=1000

# Heartbeat Monitoring Configuration
HEARTBEAT_INTERVAL_MS=30000