{
  "name": "omni-socket",
  "version": "1.1.0",
  "description": "Standalone, multi-tenant, application-agnostic realtime Socket.IO server infrastructure.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "sdk-build": "tsc -p tsconfig.sdk.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "socket.io",
    "realtime",
    "fastify",
    "multi-tenant",
    "infrastructure"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.2.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  }
}